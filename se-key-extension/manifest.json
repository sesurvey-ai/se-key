{
  "manifest_version": 3,
  "name": "SE-KEY",
  "version": "0.4.5",
  "description": "คีย์ข้อมูลงานสำรวจจากหน้า eClaim3 ส่งเข้า API server (LAN หรือ cloud)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://eclaim3.blueventuregroup.co.th/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eclaim3.blueventuregroup.co.th/esurvey/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SE Survey Helper settings"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
