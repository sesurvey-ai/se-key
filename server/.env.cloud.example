# ============================================================
# SE Survey Helper — cloud deployment (Dokploy / Docker)
#
# Copy to `.env` next to docker-compose.yml or paste keys into the
# Dokploy "Environment Variables" panel.
#
# HOST / PORT / SE_KEY_DB / SE_KEY_LOG_DIR / TZ are baked into the Dockerfile
# defaults — only override here if you know why.
# ============================================================

# --- iSurvey upstream credentials ---------------------------
ISURVEY_URL=https://se.isurvey.mobi/service/srvEMCSrpt.php
ISURVEY_USER_ID=sesurvey
ISURVEY_PASSWORD=replace-with-real-password

# Per-attempt timeout. iSurvey is occasionally slow — 60s gives headroom.
ISURVEY_TIMEOUT_MS=60000

# In-request retries for transient upstream failures (timeout / 5xx / network).
# Total attempts = ISURVEY_RETRIES + 1. Exponential backoff starting at
# ISURVEY_RETRY_DELAY_MS, doubling each time (2s, 4s, 8s, ...).
ISURVEY_RETRIES=2
ISURVEY_RETRY_DELAY_MS=2000

# --- API auth -----------------------------------------------
# Shared secret. Every request must send header `X-API-Key: <this>`.
# Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SE_KEY_API_KEY=replace-with-64-hex-chars

# --- Retry queue --------------------------------------------
# Off by default. iSurvey is fired only on user click (บันทึก/ส่งงานใหม่).
RETRY_ENABLED=0
RETRY_INTERVAL_MS=300000
RETRY_BATCH_SIZE=20
RETRY_MAX_ATTEMPTS=10
