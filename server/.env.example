# ============================================================
# SE Survey Helper — server configuration
#
# Copy this to `.env` (same directory as package.json) on the Windows host
# and fill in the real values. Load with e.g.
#   nssm install se-key "C:\Program Files\nodejs\node.exe" "C:\se-key\server\src\server.js"
#   nssm set  se-key AppEnvironmentExtra "$(type .env)"
# or via `dotenv-cli`, `pm2 ecosystem`, etc.
# ============================================================

# --- Network ------------------------------------------------
# Bind to 0.0.0.0 so other LAN machines can reach it (not just localhost).
HOST=0.0.0.0

# Port 3000 is already used by another project on 192.168.4.122.
# Run se-key on 3100 (update extension's serverUrl to http://192.168.4.122:3100).
PORT=3100

# --- Database -----------------------------------------------
# Absolute path; WAL sidecar files (-wal, -shm) live next to it.
SE_KEY_DB=C:\se-key\server\data.db

# --- iSurvey upstream credentials ---------------------------
ISURVEY_URL=https://se.isurvey.mobi/service/srvEMCSrpt.php
ISURVEY_USER_ID=sesurvey
ISURVEY_PASSWORD=replace-with-real-password
ISURVEY_TIMEOUT_MS=15000

# --- API auth -----------------------------------------------
# Shared secret. Every request must send header `X-API-Key: <this>`.
# Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable auth (backwards-compat; not recommended for prod).
SE_KEY_API_KEY=

# --- Retry queue --------------------------------------------
# Background loop that re-sends records with isurvey_sent=0 (รอส่ง) to iSurvey.
#
# DEFAULT: 0 (disabled). iSurvey is fired only when the user clicks
# "ส่งงานใหม่" on eClaim3 and the success popup confirms — never automatic.
# Pending rows (from edits, Excel imports, etc.) stay pending and require
# explicit action to send.
#
# Set to 1 only if you want background auto-retry on transient failures.
RETRY_ENABLED=0

# (Only used when RETRY_ENABLED=1)
# Interval between cycles (ms). 5 min = 300000.
RETRY_INTERVAL_MS=300000

# Max rows attempted per cycle.
RETRY_BATCH_SIZE=20

# Give up after this many attempts per row (then left as isurvey_sent=0 with
# the error stored in retry_error). Inspect with records.html or sqlite CLI.
RETRY_MAX_ATTEMPTS=10

# --- Logging ------------------------------------------------
# Daily rolling files: logs/YYYY-MM-DD.log. Created automatically.
SE_KEY_LOG_DIR=C:\se-key\server\logs
